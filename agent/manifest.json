{
  "manifest_version": 3,
  "name": "Xtension Agent",
  "version": "0.3.0",
  "description": "Local browser agent for the Xtension extension control plane.",
  "permissions": ["management", "storage", "alarms"],
  "optional_permissions": ["history"],
  "background": {
    "service_worker": "service-worker-entry.js",
    "type": "module"
  },
  "action": {
    "default_title": "Open Xtension"
  }
}
